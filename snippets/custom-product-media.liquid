<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

{%- liquid
  # "Officially licensed" pill on the main image for licensed products
  assign licensed_haystack = product.title | append: ' ' | append: product.tags | downcase
  assign show_licensed_badge = false
  if licensed_haystack contains 'officially licensed' or licensed_haystack contains 'officially-licensed'
    assign show_licensed_badge = true
  endif

  # Open on the variant's image when the URL has ?variant=
  assign initial_slide = 0
  if product.selected_variant.featured_media
    assign initial_slide = product.selected_variant.featured_media.position | minus: 1
  endif
-%}
<div class="product-gallery-swiper-wrapper">

  <div class="swiper product-main-swiper">
    {%- if show_licensed_badge -%}
      <span class="product-gallery-badge">Officially licensed</span>
    {%- endif -%}
    <div class="swiper-wrapper">
      {%- for media in product.media -%}
        <div class="swiper-slide" data-media-type="{{ media.media_type }}" data-media-id="{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- liquid
                assign media_loading = 'lazy'
                if forloop.first
                  assign media_loading = 'eager'
                endif
              -%}
              {{
                media
                | image_url: width: 1600
                | image_tag: loading: media_loading, alt: media.alt, sizes: '(min-width: 1024px) 55vw, 100vw', widths: '600, 900, 1200, 1600'
              }}
            
            {%- when 'video' -%}
              <div class="swiper-video-container">
                {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
              </div>
              
            {%- when 'external_video' -%}
              <div class="swiper-video-container external">
                {{ media | external_video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
    
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
    
    <div class="swiper-pagination"></div>
  </div>

  <div class="swiper product-thumbs-swiper">
    <div class="swiper-wrapper">
      {%- for media in product.media -%}
        <div class="swiper-slide">
          {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: media.alt }}
          {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
            <span class="thumb-video-icon">▶</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

</div>


<script>
document.addEventListener("DOMContentLoaded", function () {
  const thumbsSwiper = new Swiper(".product-thumbs-swiper", {
    spaceBetween: 5,
    slidesPerView: 7,
    freeMode: true,
    watchSlidesProgress: true,
    breakpoints: {
      768: { slidesPerView: 7, spaceBetween: 19 },
    },
  });
  const mainSwiper = new Swiper(".product-main-swiper", {
    spaceBetween: 10,
    initialSlide: {{ initial_slide }},
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
    thumbs: {
      swiper: thumbsSwiper,
    },
    on: {
      init: function () {
        handleSlideVideo(this);
      },
      slideChange: function () {
        handleSlideVideo(this);
      },
    },
  });

  // Theme's product-info only updates the stock gallery, so sync this custom slider to the variant image
  document.addEventListener("variant:changed", function (event) {
    const mediaId = event.detail?.variant?.featured_media?.id;
    if (!mediaId) return;
    const index = Array.from(mainSwiper.slides).findIndex(
      (slide) => slide.dataset.mediaId === String(mediaId)
    );
    if (index !== -1 && index !== mainSwiper.activeIndex) {
      mainSwiper.slideTo(index);
    }
  });

  function handleSlideVideo(swiper) {
    const allVideos = swiper.el.querySelectorAll("video");
    allVideos.forEach((video) => {
      video.pause();
    });

    const activeSlide = swiper.slides[swiper.activeIndex];
    const activeVideo = activeSlide.querySelector("video");
    
    if (activeVideo) {
      activeVideo.muted = true;
      activeVideo.play().catch((error) => {
        console.log("Autoplay prevented: ", error);
      });
    }
  }
});
</script>