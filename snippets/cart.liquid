<a
  href="{{ routes.cart_url }}"
  class="m-cart-icon-bubble"
  aria-label="{{ cart.item_count }}"
>
  <span class="m-tooltip m:block m-tooltip--bottom m-tooltip--style-2">
    <svg class="m-svg-icon--medium" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="#0A2540" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M3 6H21" stroke="#0A2540" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" stroke="#0A2540" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="m-tooltip__content">{{ 'layout.cart.title' | t }}</span>
  </span>
  <m-cart-count class="m-cart-count-bubble m-cart-count{% if cart == empty %} m:hidden{% endif %}">
    {%- if cart.item_count < 100 -%}
      {{- cart.item_count -}}
    {%- else -%}
      99+
    {%- endif -%}
  </m-cart-count>
</a>
