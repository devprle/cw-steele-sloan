{%- liquid
  assign class = ''

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  unless section.settings.use_sticky_atc
    assign class = ' hide-on-desk'
  endunless

  unless section.settings.use_sticky_atc_on_mobile
    assign class = ' hide-on-mobile'
  endunless

  assign image_field = section.blocks | where: 'type', 'image_field'

  assign enable_dynamic_checkout = section.settings.enable_dynamic_checkout

  assign image = product.featured_image
  if first_3d_model and product.media.size < 2
    for media in product.media
      assign image = media
    endfor
  endif

  assign variant_available = true
  if product.selected_or_first_available_variant.available == false or quantity_rule_soldout or product.selected_or_first_available_variant == null
    assign variant_available = false
  endif
-%}
{{ 'sticky-add-to-cart.css' | asset_url | stylesheet_tag }}
<div
  class="m-sticky-addtocart {{ class }}{% if enable_dynamic_checkout %} enable-dynamic-checkout{% endif %}"
  data-show-on-desktop="{{ section.settings.use_sticky_atc }}"
  data-show-on-mobile="{{ section.settings.use_sticky_atc_on_mobile }}"
  id="Sticky-Addtocart-{{ section.id }}"
>
  <div class="{{ container }}">
    <sticky-atc
      class="steele-sticky"
      data-product-id="{{ product.id }}"
    >
      {%- liquid
        assign review_count = product.metafields.loox.num_reviews | default: product.metafields.reviews.rating_count | plus: 0
        assign review_rating = product.metafields.loox.avg_rating | default: product.metafields.reviews.rating.value | default: 0 | plus: 0 | round
        assign sticky_variant = product.selected_or_first_available_variant
      -%}
      <div class="m-sticky-addtocart--leftblock steele-sticky__product">
        <div class="m-sticky-addtocart--image steele-sticky__image">
          {%- if image -%}
            {{ image | image_url: width: 160 | image_tag: loading: 'lazy', alt: product.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'm-placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="m-sticky-addtocart--title steele-sticky__info">
          {%- if review_count > 0 -%}
            <div class="steele-sticky__rating">
              <span class="steele-sticky__stars" aria-hidden="true">
                {%- for star in (1..5) -%}
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.9125 10.5L3.725 6.9875L1 4.625L4.6 4.3125L6 1L7.4 4.3125L11 4.625L8.275 6.9875L9.0875 10.5L6 8.6375L2.9125 10.5Z" fill="{% if star <= review_rating %}#000000{% else %}#D9D9D9{% endif %}"/>
                  </svg>
                {%- endfor -%}
              </span>
              <span>{{ review_count }} {% if review_count == 1 %}review{% else %}reviews{% endif %}</span>
            </div>
          {%- endif -%}
          <h3 class="steele-sticky__name">{{ product.title }}</h3>
          <span class="steele-sticky__price" data-sticky-price>{{ sticky_variant.price | money }}</span>
        </div>
      </div>
      <div class="m-sticky-addtocart--rightblock steele-sticky__actions">
        {%- assign product_form_id = 'sticky-atc-form-' | append: section.id -%}
        {%- assign product_form_class = 'sticky-atc-form product-form-' | append: section.id -%}
        <product-form class="m-product-form">
          {%- form 'product',
            product,
            id: product_form_id,
            data-product-id: product.id,
            class: product_form_class,
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form'
          -%}
            <div class="m-product-form__wrapper steele-sticky__form" id="QuantityForm-{{ section.id }}">
              <input type="hidden" name="id" value="{{ sticky_variant.id }}">
              {%- unless product.has_only_default_variant -%}
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign option_name_downcase = option.name | downcase
                    assign is_color_option = false
                    if option_name_downcase contains 'color' or option_name_downcase contains 'colour'
                      assign is_color_option = true
                    endif
                  -%}
                  <label class="steele-sticky__select{% if is_color_option %} steele-sticky__select--color{% endif %}">
                    {%- if is_color_option -%}
                      <span class="steele-sticky__swatch" data-sticky-swatch></span>
                    {%- endif -%}
                    <span class="steele-sticky__select-label">{{ option.name | escape }}</span>
                    <svg class="steele-sticky__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <select data-sticky-option data-option-index="{{ forloop.index0 }}" aria-label="{{ option.name | escape }}">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign swatch_value = ''
                          if value.swatch.color
                            assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                          elsif value.swatch.image
                            assign swatch_value = value.swatch.image | image_url: width: 40 | prepend: 'url(' | append: ')'
                          else
                            assign value_downcase = value | downcase | strip
                            assign product_colors = settings.product_colors | split: ','
                            for product_color in product_colors
                              assign parts = product_color | strip | split: ':'
                              assign color_name = parts.first | downcase | strip
                              if color_name == value_downcase
                                assign swatch_value = parts.last | strip
                              endif
                            endfor
                            if swatch_value == blank
                              assign swatch_value = value_downcase
                            endif
                          endif
                        -%}
                        <option
                          value="{{ value | escape }}"
                          data-option-value-id="{{ value.id }}"
                          data-swatch="{{ swatch_value | escape }}"
                          {% if value == sticky_variant.options[forloop.parentloop.index0] %}selected{% endif %}
                        >
                          {{- value | escape -}}
                        </option>
                      {%- endfor -%}
                    </select>
                  </label>
                {%- endfor -%}
              {%- endunless -%}

              <button
                type="submit"
                name="add"
                class="m-add-to-cart m-spinner-button m-button m-button--primary steele-sticky__atc"
                data-atc-text="{{ 'products.product.add_to_cart' | t }}"
                {% unless variant_available %}
                  disabled
                {% endunless %}
              >
                <span class="m-spinner-icon">
                  <svg
                    class="animate-spin m-svg-icon--medium"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                  >
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </span>
                <span class="m-add-to-cart--text">
                  {%- if product.selected_or_first_available_variant == null -%}
                    {{ 'products.product.unavailable' | t }}
                  {%- elsif product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- else -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- endif -%}
                </span>
              </button>
            </div>
          {%- endform -%}
        </product-form>
      </div>
    </sticky-atc>
    <script type="application/json">
      {{ product.variants | json }}
    </script>
  </div>
</div>
<script src="{{ 'sticky-atc.js' | asset_url }}" defer="defer"></script>
