<style>
  .custom-features-section {
    background-color: {{ section.settings.background_color | default: '#002b2b' }};
    position: relative;
    overflow: hidden;
    padding-top: {{ section.settings.mobile_padding_top | default: '30' }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom | default: '30' }}px;
  }

  .deco-img {
    position: absolute;
    width: 150px;
    z-index: 1;
    pointer-events: none;
  }
  .top-left { top: 20px; left: 20px; }
  .bottom-right { bottom: 20px; right: 20px; }

  .custom-features-wrapper {
    max-width: {{ section.settings.page_width | default: '1200' }}px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }

  .features-title {
    color: {{ section.settings.title_color | default: '#ffffff' }};
    font-size: {{ section.settings.title_size_mobile | default: '32' }}px;
    text-align: center;
    margin-bottom: 40px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .feature-item { text-align: center; color: {{ section.settings.text_color | default: '#ffffff' }}; }
  .feature-item img { max-width: 60px; margin-bottom: 15px; }

  @media (min-width: 768px) {
    .custom-features-section {
      padding-top: {{ section.settings.tablet_padding_top | default: '40' }}px;
      padding-bottom: {{ section.settings.tablet_padding_bottom | default: '40' }}px;
    }
    .features-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .custom-features-section {
      padding-top: {{ section.settings.padding_top | default: '60' }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: '60' }}px;
    }
    .features-title { font-size: {{ section.settings.title_size_desktop | default: '45' }}px; }
    .features-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>

<div class="custom-features-section {{ section.settings.custom_class }}">
  {% if section.settings.top_left_image != blank %}
    <img
      src="{{ section.settings.top_left_image | image_url }}"
      height="auto"
      width="auto"
      class="deco-img top-left"
      alt="decor"
    >
  {% endif %}

  {% if section.settings.bottom_right_image != blank %}
    <img
      src="{{ section.settings.bottom_right_image | image_url }}"
      height="auto"
      width="auto"
      class="deco-img bottom-right"
      alt="decor"
    >
  {% endif %}

  <div class="custom-features-wrapper">
    {% if section.settings.title != blank %}
      <h2 class="features-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="features-grid">
      {% for block in section.blocks %}
        <div class="feature-item">
          {% if block.settings.icon != blank %}
            <img
              src="{{ block.settings.icon | image_url }}"
              height="auto"
              width="auto"
              alt="{{ block.settings.title }}"
            >
          {% endif %}

          {% if block.settings.title != blank %}
            <h3>{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.content != blank %}
            <p>{{ block.settings.content }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
