{% style %}
  #{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  #{{ section.id }} .features-grid-container {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: 0 60px;
    width: 100%;
  }

  #{{ section.id }} .features-grid-inner {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  /* Left Side: Image Block */
  #{{ section.id }} .features-grid-image-wrapper {
    flex: 1;
    width: 70%;
    display:flex;
    max-width:450px;
  }

  #{{ section.id }} .features-grid-image-wrapper .image-element {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    max-width: 540px;
  }

  #{{ section.id }} .features-grid-image-placeholder {
    width: 100%;
    background-color: #e0e0e0;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Right Side: Content Block */
  #{{ section.id }} .features-grid-content-wrapper {
    flex: 1;
    width: 100%;
    text-align: {{ section.settings.text_alignment }};
  }

  #{{ section.id }} .features-main-title {
    font-family: 'Inter', sans-serif;
    color: #000;
    margin: 0 0 22px 0;
    font-weight: 200;
    font-size: 42px;
    line-height: 100%;
    letter-spacing: 0%;
  }

  #{{ section.id }} .features-main-desc {
    font-family: 'Inter', sans-serif;
    color: {{ section.settings.text_color }};
    margin: 0 40px 80px 0px;
    font-weight: 200;
    font-size: 16px;
    line-height: 130%;
    letter-spacing: 0%;
  }

  #{{ section.id }} .features-main-desc p {
    margin: 0;
  }

  /* 2x2 Grid Layout with Borders */
  #{{ section.id }} .features-items-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    position: relative;
  }

  #{{ section.id }} .feature-grid-item {
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    text-align: left;
    position: relative;
  }

  /* Custom Clean Border Layout (No overlapping) */
  #{{ section.id }} .feature-grid-item:nth-child(1) {
    border-right: 1px solid {{ section.settings.border_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
    padding-left: 0;
    padding-top: 10px;
  }

  #{{ section.id }} .feature-grid-item:nth-child(2) {
    border-bottom: 1px solid {{ section.settings.border_color }};
    padding-right: 0;
    padding-top: 10px;
  }

  #{{ section.id }} .feature-grid-item:nth-child(3) {
    border-right: 1px solid {{ section.settings.border_color }};
    padding-left: 0;
    padding-bottom: 10px
  }

  #{{ section.id }} .feature-grid-item:nth-child(4) {
    padding-right: 0;
    padding-bottom: 10px;
  }

  #{{ section.id }} .feature-item-title {
    font-family: 'Inter', sans-serif;
    color: {{ section.settings.text_color }};
    margin: 0 0 10px 0;
    font-weight: 200;
    font-size: 22px;
    line-height: 100%;
    letter-spacing: 0%;
  }

  #{{ section.id }} .feature-item-desc {
    font-family: 'Inter', sans-serif;
    color: {{ section.settings.text_color }};
    margin: 0;
    font-weight: 200;
    font-size: 12px;
    line-height: 160%;
    letter-spacing: 0%;
  }

  #{{ section.id }} .feature-item-desc p {
    margin: 0;
  }

  /* Tablet Styling */
  @media screen and (max-width: 1024px) {
    #{{ section.id }} .features-main-desc {
      margin: 0 40px 40px 0px;
    }
    #{{ section.id }} .feature-grid-item{
      padding: 20px;
    }
    #{{ section.id }} {
      padding-top: {{ section.settings.tablet_padding_top }}px;
      padding-bottom: {{ section.settings.tablet_padding_bottom }}px;
    }
    #{{ section.id }} .features-grid-container {
      padding: 0 30px;
    }
    #{{ section.id }} .features-grid-inner {
      gap: 40px;
    }
    #{{ section.id }} .features-main-title {
      font-size: 32px;
    }
  }

  /* Mobile Styling */
  @media screen and (max-width: 767px) {
    #{{ section.id }} .features-main-desc {
      margin: 0 0px 0px 0px;
      font-size: 13px;
      text-align: center;
    }
    #{{ section.id }} .features-main-title {
      font-size: 30px;
      text-align: center;
    }
    #{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
    #{{ section.id }} .features-grid-container {
      padding: 0 15px;
    }
    #{{ section.id }} .features-grid-inner {
      flex-direction: column-reverse;
      gap: 30px;
    }
    #{{ section.id }} .features-items-grid{
      padding-top: 22px;
    }
    #{{ section.id }} .feature-grid-item {
      padding: 20px 0 !important;
    }
    #{{ section.id }} .feature-grid-item:last-child {
      border-bottom: none !important;
    }
    #{{ section.id }} .feature-item-title {
      font-size: 16px;
      margin-bottom: 8px;
    }
    #{{ section.id }} .feature-grid-item {
      padding: 10px !important;
      text-align: center;
    }
  }
{% endstyle %}

<section id="{{ section.id }}" class="features-grid-section {{ section.settings.custom_class }}">
  <div class="features-grid-container">
    <div class="features-grid-inner">
      
    <!-- Left Side: Product First Image -->
<div class="features-grid-image-wrapper">
  {%- assign product_first_image = product.images.first -%}

  {%- if product_first_image != blank -%}
    <img 
      src="{{ product_first_image | image_url: width: 1000 }}" 
      alt="{{ product_first_image.alt | default: product.title | escape }}"
      class="image-element"
      loading="lazy"
    >
  {%- elsif section.settings.image != blank -%}
    <img 
      src="{{ section.settings.image | image_url: width: 1000 }}" 
      alt="{{ section.settings.image.alt | escape }}"
      class="image-element"
      loading="lazy"
    >
  {%- else -%}
    <div class="features-grid-image-placeholder">
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}
</div>

      <!-- Right Side: Content & 2x2 Grid -->
      <div class="features-grid-content-wrapper">
        {%- if section.settings.title != blank -%}
          <h2 class="features-main-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        
        {%- if section.settings.description != blank -%}
          <div class="features-main-desc">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        <div class="features-items-grid">
          {%- for block in section.blocks -%}
            <div class="feature-grid-item" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3 class="feature-item-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="feature-item-desc">
                  {{ block.settings.description }}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features Image Grid",
  "settings": [
    {
      "type": "header",
      "content": "Media Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    },
    {
      "type": "header",
      "content": "Text Header Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why you'll love it"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Bring on-trend, giftable styles to your shelves, with great quality and pricing, plus the kind of service that keeps retailers coming back</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Style & Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Grid Divider Line Color",
      "default": "#e0e0e0"
    },
    {
      "type": "number",
      "id": "page_width",
      "label": "Page Width (px)",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Desktop Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 150, "step": 2, "unit": "px", "label": "Top Padding", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 150, "step": 2, "unit": "px", "label": "Bottom Padding", "default": 60
    },
    {
      "type": "header",
      "content": "Tablet Section Padding"
    },
    {
      "type": "range",
      "id": "tablet_padding_top",
      "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top Padding", "default": 40
    },
    {
      "type": "range",
      "id": "tablet_padding_bottom",
      "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom Padding", "default": 40
    },
    {
      "type": "header",
      "content": "Mobile Section Padding"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top Padding", "default": 30
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom Padding", "default": 30
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Grid Feature Item",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Feature Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features Image Grid",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Sensitive-skin friendly:",
            "description": "<p>hypoallergenic comfort for all-day wear</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Giftable favorite",
            "description": "<p>a reliable win for Alabama fans</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Low-maintenance shine",
            "description": "<p>stainless steel chain designed to resist tarnish</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Easy statement",
            "description": "<p>chunky chain look, minimalist vibe</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}