{% style %}
  #{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  #{{ section.id }} .faq-wrapper {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: 0 60px;
    display: flex;
    gap: 50px;
  }

  #{{ section.id }} .faq-wrapper {
    justify-content: space-between;
    align-items: flex-start;
  }

  #{{ section.id }} .faq-sidebar {
    flex: 0 1 431px;
    position: sticky;
    top: 120px;
  }

  #{{ section.id }} .faq-title {
    font-family: 'Inter', sans-serif;
    color: #000000;
    margin: 0 0 22px 0;
    font-weight: 200;
    font-size: 52px;
    line-height: normal;
    letter-spacing: 0%;
    max-width: 418px;
  }

  #{{ section.id }} .faq-subtitle {
    font-family: 'Inter', sans-serif;
    color: #000000;
    margin: 0;
    font-weight: 200;
    font-size: 16px;
    line-height: 120%;
    letter-spacing: 0%;
    max-width: 433px;
  }

  #{{ section.id }} .faq-content {
    flex: 1;
    max-width: 764px;
  }

  #{{ section.id }} .faq-item {
    border-bottom: 1px solid {{ section.settings.divider_color }};
    padding-bottom: 30px;
    margin-bottom: 30px;
  }

  #{{ section.id }} .faq-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  #{{ section.id }} .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    font-family: 'Inter', sans-serif;
    color: #000000;
    font-weight: 200;
    font-size: 14px;
    line-height: normal;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  #{{ section.id }} .faq-question::-webkit-details-marker {
    display: none;
  }

  #{{ section.id }} .faq-icon {
    flex: 0 0 16px;
    transition: transform 0.25s ease;
  }

  #{{ section.id }} .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  #{{ section.id }} .faq-item[open] .faq-answer {
    padding-top: 15px;
    animation: faqReveal-{{ section.id }} 0.25s ease;
  }

  @keyframes faqReveal-{{ section.id }} {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
  }
  #{{ section.id }} .faq-answer,
  #{{ section.id }} .faq-answer p,
  #{{ section.id }} .faq-answer li {
    font-family: 'Inter', sans-serif;
    font-weight: 300;
    font-size: 16px;
    line-height: 160%;
    letter-spacing: 0%;
    color: #000000;
  }

  #{{ section.id }} .faq-answer p {
    margin: 0;
  }

  #{{ section.id }} .faq-answer ul {
    margin: 8px 0 0;
    padding-left: 20px;
  }

  /* Responsive Design */
  @media screen and (max-width: 1024px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.tablet_padding_top }}px;
      padding-bottom: {{ section.settings.tablet_padding_bottom }}px;
    }
    #{{ section.id }} .faq-wrapper {
      padding: 0 30px;
      gap: 30px;
    }
    #{{ section.id }} .faq-title {
      font-size: 38px;
    }
  }
  @media(max-width: 850px){
    #{{ section.id }} .faq-sidebar {
        position: static;
        flex-basis: auto;
    }
    #{{ section.id }} .faq-wrapper {
        padding: 0 30px;
        gap: 50px;
        flex-direction: column;
    }
  }
  @media screen and (max-width: 767px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
    #{{ section.id }} .faq-wrapper {
      flex-direction: column;
      padding: 0 20px;
      gap: 40px;
    }
    #{{ section.id }} .faq-sidebar {
      flex: none;
      text-align: left;
    }
    #{{ section.id }} .faq-title {
        font-size: 30px;
        text-align: center;
        max-width: 300px;
        margin: 0 auto 15px;
    }
    #{{ section.id }} .faq-item[open] .faq-answer{
        padding-top: 8px;
    }
    #{{ section.id }} .faq-answer,
    #{{ section.id }} .faq-answer p,
    #{{ section.id }} .faq-answer li {
        font-size: 13px;
    }
    #{{ section.id }} .faq-item{
        padding-bottom: 13px;
        margin-bottom: 13px;
    }
    #{{ section.id }} .faq-subtitle{
        font-size: 13px;
        max-width: 273px;
        text-align: center;
        margin: 0 auto;
    }
  }
{% endstyle %}

<section id="{{ section.id }}" class="faq-section-main {{ section.settings.custom_class }}">
  <div class="faq-wrapper">
    
    <div class="faq-sidebar">
      {%- if section.settings.title != blank -%}
        <h2 class="faq-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="faq-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="faq-content">
      {%- assign faq_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' and block.settings.question != blank -%}
          {%- assign faq_index = faq_index | plus: 1 -%}
          <details
            class="faq-item"
            name="faq-{{ section.id }}"
            {% if faq_index == 1 %}open{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="faq-question">
              <span>{{ block.settings.question }}</span>
              <svg class="faq-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            {%- if block.settings.answer != blank -%}
              <div class="faq-answer">
                {{ block.settings.answer }}
              </div>
            {%- endif -%}
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<script>
  // Only one answer open at a time (fallback for browsers without <details name> support)
  (function () {
    const section = document.getElementById('{{ section.id }}');
    if (!section) return;
    const items = section.querySelectorAll('.faq-item');
    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        items.forEach((other) => {
          if (other !== item && other.open) other.open = false;
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Custom FAQ",
  "settings": [
    {
      "type": "header",
      "content": "Sidebar Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Fast shipping, beautiful products, and service that keeps people coming back"
    },
    {
      "type": "header",
      "content": "Style & Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Sidebar Text Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "answer_color",
