{% style %}
  #{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  #{{ section.id }} .page-width {
    max-width: {{ section.settings.page_width }}%;
    padding: 0;
    margin: 0 auto;
    width: 100%;
  }

  #{{ section.id }} .boutique-wholesale-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: 0;
  }

  #{{ section.id }} .boutique-wholesale-image {
    position: relative;
    height: 100%;
  }

  #{{ section.id }} .boutique-wholesale-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    max-height:600px;
  }

  #{{ section.id }} .boutique-wholesale-content {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F2F2F2;
    padding: 0 0 0 30px;
  }

  #{{ section.id }} .boutique-wholesale-content-inner {
    max-width: 540px;
    width: 100%;
  }

  #{{ section.id }} .boutique-wholesale-title {
    margin: 0 0 22px;
    color: #0A2540;
    font-family: Inter;
    font-weight: 200;
    font-size: 42px;
    line-height: 1.22;
    letter-spacing: 0.9px;
    max-width: 492px;
  }

  #{{ section.id }} .boutique-wholesale-description {
    max-width: 445px;
    margin-bottom: 22px;
    color: #0A2540;
    font-family: Inter;
    font-weight: 200;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #{{ section.id }} .boutique-wholesale-btns {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }

  #{{ section.id }} .boutique-wholesale-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 18.4px;
    text-decoration: none;
    transition: all 0.3s ease;
    font-family: Inter;
    font-weight: 200;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  #{{ section.id }} .boutique-wholesale-btn.primary-btn {
    background: #0A2540;
    color: #ffffff;
    border: 1px solid #0A2540;
  }

  #{{ section.id }} .boutique-wholesale-btn.primary-btn:hover {
    background: transparent;
    color: #0A2540;
  }

  #{{ section.id }} .boutique-wholesale-btn.secondary-btn {
    border: 1px solid #98A2B3;
    color: #667085;
    background: #fff;
    padding: 16px 30.5px;
  }
  #{{ section.id }} .boutique-wholesale-btn.secondary-btn:hover {
    background: #0A2540;
    border-color: #0A2540;
    color: #ffffff;
  }
  #{{ section.id }} .boutique-wholesale-review-star {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 16px;
  }
  #{{ section.id }} .boutique-wholesale-review-star svg {
    width: 16px;
    height: 16px;
    fill: #0A2540;
  }
  #{{ section.id }} .boutique-wholesale-review-text {
    margin-bottom: 10px;
    color: #0A2540;
    font-family: Inter;
    font-weight: 200;
    font-size: 14px;
    line-height: 1.5;
    max-width: 402px;
  }
  #{{ section.id }} .boutique-wholesale-review-author {
    color: #0A2540;
    font-family: Inter;
    font-weight: 200;
    font-size: 12px;
    line-height: 1.4;
  }
  section.boutique-wholesale-section.pdp-review {
    position: relative;
  }
  
  section.boutique-wholesale-section.pdp-review:after {
    content: '';
    position: absolute;
    bottom: -144px;
    right: -35px;
    background-image: url(https://cdn.shopify.com/s/files/1/0760/9971/5325/files/10c37c67a4050cb8a6ebd516079ca4903e25e541_1.png?v=1780554120);
    width: 210px;
    height: 220px;
    background-size: contain;
    background-repeat: no-repeat;
  }

  @media screen and (max-width: 1024px) {

    #{{ section.id }} {
      padding-top: {{ section.settings.tablet_padding_top }}px;
      padding-bottom: {{ section.settings.tablet_padding_bottom }}px;
    }

    #{{ section.id }} .boutique-wholesale-content {
      padding: 50px 40px;
    }

    #{{ section.id }} .boutique-wholesale-title {
      font-size: 42px;
    }
    #{{ section.id }} .boutique-wholesale-btn{
      max-width: 100%;
      width: 100%;
    }

  }
  @media(max-width: 850px){
    #{{ section.id }} .boutique-wholesale-main {
       grid-template-columns: 1fr;
    }
  } 
  @media screen and (max-width: 767px) {

    #{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section.id }} .boutique-wholesale-main {
      grid-template-columns: 1fr;
    }

    #{{ section.id }} .boutique-wholesale-image {
      height: 420px;
    }

    #{{ section.id }} .boutique-wholesale-content {
      padding: 40px 24px;
    }

    #{{ section.id }} .boutique-wholesale-title {
      font-size: 30px;
      max-width: 300px;
      text-align: center;
      width: 100%;
      margin: 0 auto 15px;
    }

    #{{ section.id }} .boutique-wholesale-description {
      font-size: 13px;
      max-width: 300px;
      text-align: center;
      width: 100%;
      margin: 0 auto 24px;
    }
    #{{ section.id }}.pdp-review .boutique-wholesale-description{
       margin: 0 auto 0px;
    }
    .boutique-wholesale-review-star {
      justify-content: center;
    }
    .boutique-wholesale-review {
      max-width: 242px;
      margin: 0 auto;
      text-align: center;
    }
    #{{ section.id }} .boutique-wholesale-btns {
      flex-direction: column;
      align-items: stretch;
      max-width: 220px;
      margin: 0 auto 22px;
      width: 100%;
    }
    #{{ section.id }} .boutique-wholesale-btn.primary-btn{
      padding: 16px 8px;
    }
  }
{% endstyle %}

<section id="{{ section.id }}" class="boutique-wholesale-section {{ section.settings.custom_class }}">
  <div class="page-width">

    <div class="boutique-wholesale-main">

      <div class="boutique-wholesale-image">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.title }}"
            width="auto"
            height="auto"
          >
        {% endif %}
      </div>

      <div class="boutique-wholesale-content">
        <div class="boutique-wholesale-content-inner">

          {% if section.settings.title != blank %}
            <h2 class="boutique-wholesale-title">
              {{ section.settings.title }}
            </h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="boutique-wholesale-description">
              {{ section.settings.description }}
            </div>
          {% endif %}

          <div class="boutique-wholesale-btns">

            {% if section.settings.primary_btn_text != blank and section.settings.primary_btn_link != blank %}
              <a href="{{ section.settings.primary_btn_link }}" class="boutique-wholesale-btn primary-btn">
                {{ section.settings.primary_btn_text }}
              </a>
            {% endif %}

            {% if section.settings.secondary_btn_text != blank and section.settings.secondary_btn_link != blank %}
              <a href="{{ section.settings.secondary_btn_link }}" class="boutique-wholesale-btn secondary-btn">
                {{ section.settings.secondary_btn_text }}
              </a>
            {% endif %}

          </div>
        {% if section.settings.review_text != blank %}
          <div class="boutique-wholesale-review">
            <div class="boutique-wholesale-review-star">
              {% for i in (1..5) %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M12 17.27L18.18 21 16.54 13.97 22 9.24 14.81 8.63 12 2 9.19 8.63 2 9.24 7.46 13.97 5.82 21z"/>
                </svg>
              {% endfor %}
            </div>
            {% if section.settings.review_text != blank %}
              <div class="boutique-wholesale-review-text">
                {{ section.settings.review_text }}
              </div>
            {% endif %}
            {% if section.settings.review_author != blank %}
              <div class="boutique-wholesale-review-author">
                {{ section.settings.review_author }}
              </div>
            {% endif %}
          </div>
        {% endif %}
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Boutique Wholesale",
  "settings": [
    {
      "type": "header",
      "content": "General settings"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "number",
      "id": "page_width",
      "label": "Page width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Section image"
    },

    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Stock Steele Sloan Designs in your boutique"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Bring on-trend, giftable styles to your shelves, with great quality and pricing, plus the kind of service that keeps retailers coming back"
    },

    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary button text",
      "default": "Apply For Wholesale"
    },

    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary button link"
    },

    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary button text",
      "default": "Shop On Faire"
    },

    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary button link"
    },

    {
      "type": "textarea",
      "id": "review_text",
      "label": "Review text",
      "default": "Absolutely beautiful earrings! Fast delivery and they look even better in person. My daughter is obsessed!"
    },

    {
      "type": "text",
      "id": "review_author",
      "label": "Review author",
      "default": "Sara, Boutique Ltd"
    },

    {
      "type": "header",
      "content": "Desktop section padding"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },

    {
      "type": "header",
      "content": "Tablet section padding"
    },

    {
      "type": "range",
      "id": "tablet_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Tablet top padding",
      "default": 60
    },

    {
      "type": "range",
      "id": "tablet_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Tablet bottom padding",
      "default": 60
    },

    {
      "type": "header",
      "content": "Mobile section padding"
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],

  "presets": [
    {
      "name": "Boutique Wholesale"
    }
  ]
}
{% endschema %}