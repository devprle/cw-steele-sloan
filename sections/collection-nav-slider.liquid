{% style %}
  #{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
    overflow: hidden;
  }

  #{{ section.id }} .coll-slider-wrapper {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: 0 60px;
    display: flex;
    align-items: center;
    gap: 46px;
  }

  #{{ section.id }} .coll-slider-sidebar {
    flex: 0 0 224px;
    min-width: 0;
  }

  #{{ section.id }} .coll-slider-sidebar h2 {
    font-family: 'Inter', sans-serif;
    color: {{ section.settings.text_color }};
    margin: 0;
    max-width: 224px;
    font-weight: 200;
    font-size: 42px;
    line-height: normal;
    letter-spacing: 0;
  }

  #{{ section.id }} .coll-slider-outer {
    flex: 1;
    min-width: 0;
  }

  /* Desktop: one wrapping list of chips (the two rows only matter on mobile) */
  #{{ section.id }} .coll-slider-content {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  #{{ section.id }} .coll-chip-row {
    display: contents;
  }

  #{{ section.id }} .coll-slider-item {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    background: #ffffff;
    border: 1px solid #000000;
    color: #000000;
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: normal;
    text-decoration: none;
    white-space: nowrap;
    -webkit-user-drag: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #{{ section.id }} .coll-slider-item:hover,
  #{{ section.id }} .coll-slider-item.is-active {
    background: #000000;
    color: #ffffff;
  }

  @media screen and (max-width: 1024px) {
    #{{ section.id }} .coll-slider-wrapper {
      padding: 0 30px;
      gap: 30px;
    }

    #{{ section.id }} .coll-slider-sidebar {
      flex-basis: 180px;
    }

    #{{ section.id }} .coll-slider-sidebar h2 {
      font-size: 36px;
    }
  }

  @media screen and (max-width: 767px) {
    #{{ section.id }} {
      padding-top: 24px;
      padding-bottom: 24px;
    }

    #{{ section.id }} .coll-slider-wrapper {
      flex-direction: column;
      align-items: stretch;
      padding: 0;
      gap: 16px;
    }

    #{{ section.id }} .coll-slider-sidebar {
      flex: none;
      width: 100%;
      max-width: 100%;
    }

    #{{ section.id }} .coll-slider-sidebar h2 {
      max-width: 100%;
      font-size: 18px;
      text-align: center;
    }

    /* Mobile: two rows that scroll sideways together */
    #{{ section.id }} .coll-slider-content {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 8px;
      padding: 0 10px;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      scroll-padding-inline: 10px;
    }

    #{{ section.id }} .coll-slider-content::-webkit-scrollbar {
      display: none;
    }

    #{{ section.id }} .coll-chip-row {
      display: flex;
      gap: 8px;
      width: max-content;
    }

    #{{ section.id }} .coll-slider-item {
      padding: 8px 12px;
      font-size: 13px;
    }
  }
{% endstyle %}

{%- liquid
  assign chip_count = 0
  for block in section.blocks
    if block.type == 'collection_item' and block.settings.collection != blank
      assign chip_count = chip_count | plus: 1
    endif
  endfor
  assign first_row_size = chip_count | plus: 1 | divided_by: 2
-%}

<section id="{{ section.id }}" class="collection-slider-section {{ section.settings.custom_class }}">
  <div class="coll-slider-wrapper">

    <div class="coll-slider-sidebar">
      <h2>{{ section.settings.title }}</h2>
    </div>

    <div class="coll-slider-outer">
      <div class="coll-slider-content" id="Slider-{{ section.id }}">
        <div class="coll-chip-row">
          {%- assign chip_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection_item' -%}
              {%- assign featured_collection = collections[block.settings.collection] -%}

              {%- if featured_collection != blank -%}
                {%- liquid
                  assign chip_index = chip_index | plus: 1
                  assign is_active = false
                  if template.name == 'collection' and collection.handle == featured_collection.handle
                    assign is_active = true
                  endif
                  assign chip_label = block.settings.chip_label | default: block.settings.custom_title | default: featured_collection.title
                -%}
                <a
                  href="{{ featured_collection.url }}"
                  class="coll-slider-item{% if is_active %} is-active{% endif %}"
                  {% if is_active %}aria-current="page"{% endif %}
                  {{ block.shopify_attributes }}
                >
                  {{- chip_label | escape -}}
                </a>
                {%- if chip_index == first_row_size -%}
                  </div><div class="coll-chip-row">
                {%- endif -%}
              {%- elsif request.design_mode -%}
                <span class="coll-slider-item" {{ block.shopify_attributes }}>College name</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  (function () {
    const slider = document.getElementById('Slider-{{ section.id }}');
    if (!slider) return;

    const updateEnd = () => {
      const atEnd = slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 2;
      slider.classList.toggle('is-at-end', atEnd);
    };
    slider.addEventListener('scroll', updateEnd, { passive: true });
    window.addEventListener('resize', updateEnd);
    updateEnd();

    // Bring the active college into view on load
    const active = slider.querySelector('.coll-slider-item.is-active');
    if (active) {
      slider.scrollLeft = active.offsetLeft - slider.offsetLeft - 20;
    }

    // Mouse drag to scroll (touch devices scroll natively)
    let startX = 0;
    let startScroll = 0;
    let isDown = false;
    let moved = false;

    slider.addEventListener('mousedown', (e) => {
      isDown = true;
      moved = false;
      startX = e.pageX;
      startScroll = slider.scrollLeft;
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      const delta = e.pageX - startX;
      if (Math.abs(delta) > 5) {
        moved = true;
        slider.classList.add('is-dragging');
      }
      slider.scrollLeft = startScroll - delta;
    });

    window.addEventListener('mouseup', () => {
      isDown = false;
      slider.classList.remove('is-dragging');
    });

    // Don't follow a link at the end of a drag
    slider.addEventListener('click', (e) => {
      if (moved) {
        e.preventDefault();
        moved = false;
      }
    }, true);
  })();
</script>

{% schema %}
{
  "name": "Collection Nav Slider",
  "settings": [
    {
      "type": "header",
      "content": "Sidebar Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Browse Colleges"
    },
    {
      "type": "header",
      "content": "Style & Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#eeeeee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Sidebar Title Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "item_text_color",
      "label": "Circle Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "active_border_color",
      "label": "Active Item Border Color",
      "default": "#d1b06b"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Circle Image Dark Overlay",
      "default": 40
    },
    {
      "type": "number",
      "id": "page_width",
      "label": "Page Width (px)",
      "default": 1300
    },
    {
      "type": "header",
      "content": "Desktop Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection Circle",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Circle Image"
        },
        {
          "type": "text",
          "id": "chip_label",
          "label": "Short label",
          "info": "Shown on the chip, e.g. \"Alabama\". Falls back to the custom title, then the collection title."
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title Over Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Nav Slider",
      "blocks": [
        {
          "type": "collection_item"
        },
        {
          "type": "collection_item"
        },
        {
          "type": "collection_item"
        },
        {
          "type": "collection_item"
        }
      ]
    }
  ]
}
{% endschema %}

