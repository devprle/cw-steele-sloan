{{ 'component-product-inventory.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
{%- if template.suffix == 'flash-sale' -%}
  <script src="{{ 'foxkit-flashsale-countdown.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'foxkit-flash-sale.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% style %}
  .m-toolbar--sortby,
  .m-sidebar--open {
    border: 1px solid #000000;
    max-width: 256px;
    width: 100%;
    padding: 10px 14px;
    justify-content: space-between;
    margin: 0;
  }
  .m-facet-checkbox {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border: 1px solid #a3a3a3;
    border-radius: 2px;
    background-color: #fff;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  .m-facet-checkbox.checked,
  .m-link-lists--item.active .m-facet-checkbox {
    border-color: #000;
    background-color: #000;
    color: #fff;
  }
  .m-facet-checkbox .m-svg-icon {
    display: none;
    width: 12px;
    height: 12px;
    stroke: currentColor;
  }
  .m-facet-checkbox.checked .m-svg-icon,
  .m-link-lists--item.active .m-facet-checkbox .m-svg-icon {
    display: block;
  }

  .m-link-lists--item .m-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #2b2b2b;
    font-size: 15px;
    font-family: inherit;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  span.m-select-custom--trigger-text,
  .m-sidebar--open span {
    font-family: Inter;
    font-weight: 300;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 5%;
    text-align: center;
    text-transform: uppercase;
  }
  .m-link-lists--item .m-link:hover {
    color: #000;
  }
  .m-link-lists--item span.m-facet-text {
    font-family: Inter;
    font-weight: 300;
    font-size: 14px;
    line-height: normal;
    letter-spacing: 0;
  }
  span.m-price-item.m-price-item--regular {
    font-family: Inter;
    font-weight: 600;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0;
    color: #000000;
  }
  .m-product-card .m-product-option--swatch .m-product-option--node__label {
    width: 16px;
    height: 16px;
    margin: 0 10px 0 0;
  }
  .m-product-card .product-review span {
    color: #000000;
  }
  .product-review path {
    fill: #000;
  }
  .m-collection--wrapper .m-collection-products{
    margin: 31px 0 0;
  }
  .m-product-card button.m-product-form.m-button,
  .m-collection-products product-form.m-product-form .m-add-to-cart {
    border: 1px solid #000000;
    font-family: Inter;
    font-weight: 300;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 5%;
    text-align: center;
    text-transform: uppercase;
    color: #000000;
    padding: 14px 20px;
    border-radius: 0;
  }
  .m-product-card button.m-product-form.m-button:hover,
  .m-collection-products product-form.m-product-form .m-add-to-cart:hover {
    color: #fff;
  }
  h3.m-product-card__title a.m-product-card__name {
    font-family: Inter;
    font-weight: 200;
    font-size: 14px;
    line-height: normal;
    letter-spacing: 0%;
    color: #000000;
  }
  .m-collection--wrapper .m-link-lists--item .m-link:hover:after,
  .m-collection--wrapper .m-link-lists--item:hover .m-link:after,
  .m-collection--wrapper .m-link-lists--item.active .m-link:after {
    display: none;
  }
  .m-toolbar--product-count {
    font-family: Inter;
    font-weight: 300;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 0%;
    color: #000;
  }
  .m-filter--widget-title span,
  .m-filter--widget-title {
    font-family: Inter;
    font-weight: 200;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 5%;
    text-transform: uppercase;
    color: #000000;
  }
  .m-facets .m-facet--checkbox {
    font-family: Inter;
    font-weight: 300;
    font-size: 14px;
    line-height: 160%;
    letter-spacing: 0%;
    color: #000000;
  }
  
  /* Load more button styling */
  .m-filter--load-more-btn {
    background: none;
    border: none;
    padding: 0;
    margin-top: 10px;
    font-family: inherit;
    font-size: 14px;
    color: #2b2b2b;
    text-decoration: underline;
    cursor: pointer;
    display: inline-block;
    transition: color 0.2s ease;
    margin-left: 28px; /* aligns with text labels next to checkboxes */
  }
  .m-filter--load-more-btn:hover {
    color: #000;
  }
  
  .m-facets.has-load-more li:nth-child(n+6) {
    display: none;
  }
  .m-facets.has-load-more.expanded li:nth-child(n+6) {
    display: flex;
  }

  /* Custom grid banner review card layout styling */
  .m-grid-banner {
    display: flex;
    align-items: stretch;
  }
  .m-grid-banner .m-image-card {
    width: 100%;
    height: 100%;
    background-color: #F2F2F2;
    border-radius: 0;
    padding: 30px 20px;
    box-sizing: border-box;
  }
  .m-grid-banner .m-image-card__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    background: none;
    padding: 0;
  }
  .m-grid-banner .m-image-card__content-inner svg {
    margin: 21px 0 21px;
  }
  h3.m-richtext__title.m-image-card__heading {
    font-family: Inter;
    font-weight: 200;
    font-size: 16px;
    line-height: normal;
    margin:0;
    letter-spacing: 0;
    text-align: center;
    color: #000000;
  }
  .m-grid-banner .m-image-card__img {
    width: 148px;
    height: 148px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 0;
    flex-shrink: 0;
    aspect-ratio: 1/1;
    display: inline-block;
  }
  .m-grid-banner .m-media {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }
  .m-grid-banner .m-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .m-grid-banner .m-image-card__content {
    position: static;
    padding: 0;
    background: none;
    width: 100%;
    text-align: center;
  }
  .m-grid-banner .m-image-card__content-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .m-grid-banner .m-image-card__subheading {
    font-size: 16px;
    letter-spacing: 2px;
    color: #000;
    margin-bottom: 15px;
  }
  .m-grid-banner .m-richtext__description {
    font-size: 14.5px;
    line-height: 1.5;
    color: #4a4a4a;
    margin-bottom: 15px;
    font-style: normal;
    text-align: center;
  }
  .m-collection--wrapper .m-product-card__price .m-price__sale .m-price-item--last,
  .m-collection--wrapper .m-price__sale .m-price-item--regular{
    color: #000;
    font-family: Inter;
    font-weight: 600;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0%;
  }
  .m-collection--wrapper .m-product-card__content{
    height: 47%;
  }
  .m-collection--wrapper .m-collection-products .m-product-item{
    height: inherit;
  }
  .m-product-card.m-product-card--style-4 {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .m-grid-banner .m-richtext__button,
  .m-grid-banner .m-image-card__heading {
    color: #000000;
    text-transform: none;
    margin-top: 10px;
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    font-family: Inter;
    font-weight: 200;
    font-size: 12px;
    line-height: 160%;
    letter-spacing: 0;
    text-align: center;
  }
  @media screen and (min-width: 990px){
    .m-collection--wrapper .m-collection-products .m-product-item {
      max-width: 25%;
      width: 25%;
    } 
  }
  @media screen and (max-width: 1280px){
    .m-collection--wrapper .m-toolbar--left {
      width: 100%;
      justify-content: space-between;
      margin: 0 10px 0 0;
    }
  }
  @media(max-width: 850px){
    .m-collection--wrapper .m-product-card__content{
      height: auto;
    }
  }
  @media screen and (max-width: 767px){
    .m-collection--wrapper .m-toolbar--left {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 0;
    }
    .m-collection--wrapper .m-collection-products{
      margin: 24px 0 0;
    }
    .m-toolbar--sortby, 
    .m-sidebar--open,
    button.m-sortby--open{
      max-width: 100%;
    }
    h3.m-richtext__title.m-image-card__heading {
      font-size: 11px;
    }
    .m-grid-banner .m-richtext__button, 
    .m-grid-banner .m-image-card__heading{
      font-size: 10px;
    }
    .m-grid-banner .m-image-card__content-inner svg {
      margin: 20px 0;
    }
    .m-toolbar--sortby, 
    .m-sidebar--open,
    button.m-sortby--open{
      font-family: Inter;
      font-weight: 300;
      font-size: 12px;
      line-height: 100%;
      letter-spacing: 5%;
      text-transform: uppercase;
    }
    .m-collection-products .m-product-item {
      margin-bottom: 20px;
      padding: 0 5px;
    }
    button.m-sortby--open{
      border: 1px solid #000000;
      width: 100%;
      padding: 10px 14px;
      justify-content: space-between;
      margin: 0;
    }
  }
{% endstyle %}

{%- liquid
  assign initial_column = section.settings.grid_columns
  if section.settings.grid_layout == 'list'
    assign initial_column = 1
  endif

  assign show_filter = section.settings.show_filter
  if section.settings.filters_type == 'storefront_filters' and collection.filters.size == 0
    assign show_filter = false
  endif
  if section.settings.filters_type == 'tags_filter' and section.blocks.size == 0
    assign show_filter = false
  endif

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif
-%}

<section
  class="facest-filters-section"
  data-section-type="collection-template"
  data-section-id="{{ section.id }}"
  data-filters-type="{{ section.settings.filters_type }}"
  data-filters-position="{{ section.settings.sidebar }}"
  data-enable-filters="{{ section.settings.show_filter }}"
  data-enable-sorting="{{ section.settings.show_sorting }}"
  data-show-col-switchers="{{ section.settings.show_columns_switcher }}"
  data-pagination-type="{{ section.settings.paginate_type }}"
  data-product-count="{{ collection.products.size }}"
  data-initial-column="{{ initial_column }}"
  data-view="{{ template.name }}"
>
  <div class="{{ container }}">
    <div class="m-collection--wrapper {% if section.settings.show_filter %}m-sidebar--{{ section.settings.sidebar }}{% endif %}">
      {%- render 'collection-sidebar',
        show_filter: show_filter,
        animated: animated,
        animation_effect: animation_effect
      -%}
      <div id="CollectionProductGrid" class="m:flex-1" data-collection-id="{{ collection.id }}">
        {%- render 'collection-page-toolbar',
          section: section,
          results: collection,
          animated: animated,
          animation_effect: animation_effect
        -%}
        {%- liquid
          if section.settings.show_filter
            if section.settings.filters_type == 'storefront_filters'
              render 'collection-filters-facets', results: collection, animated: animated, animation_effect: animation_effect
            else
              render 'selected-tags-filter', animated: animated, animation_effect: animation_effect
            endif
          endif
        -%}
        {%- paginate collection.products by section.settings.pagination_limit -%}
          {%- if collection.products.size == 0 -%}
            <div class="m-collection--empty m:flex m:flex-col m:w-full m:items-center">
              <span>{%- render 'icon', name: 'empty-collection', fill: '#9a9a9a' -%}</span>
              <p class="m-collection--empty-text">{{ 'collections.general.no_matches' | t }}</p>
            </div>
          {%- else -%}
            <div
              class="m-collection-products m:flex m:flex-wrap m-cols-4"
              data-total-pages="{{ paginate.pages }}"
              data-product-container
            >
              {%- for product in collection.products -%}
                {%- for block in section.blocks -%}
                  {%- assign grid_pos = block.settings.grid_position | plus: 0 -%}
                  {%- if block.type == 'banner_promotion' and block.settings.show_in_grid and grid_pos == forloop.parentloop.index -%}
                    <div class="m-product-item m-grid-banner m:w-6/12 md:m:w-4/12">
                      {%- render 'image-card',
                        block: block,
                        index: forloop.index,
                        color_scheme: block.settings.color_scheme,
                        stack_on_mobile: false,
                        image_card_class: 'm-hover-box m-hover-box--scale-up',
                        animated: animated,
                        animation_effect: animation_effect
                      -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
                <div class="m-product-item m:w-6/12 md:m:w-4/12">
                  {% liquid
                    case settings.pcard_layout
                      when '1'
                        render 'custom-product-card', product: product, section: section, index: forloop.index, section_index: section.index, animated: animated, animation_effect: animation_effect, context: collection
                      when '2'
                        render 'product-card-2', product: product, section: section, index: forloop.index, section_index: section.index, animated: animated, animation_effect: animation_effect, context: collection
                      when '3'
                        render 'product-card-3', product: product, section: section, index: forloop.index, section_index: section.index, animated: animated, animation_effect: animation_effect, context: collection
                      when '4'
                        render 'product-card-4', product: product, section: section, index: forloop.index, section_index: section.index, animated: animated, animation_effect: animation_effect, context: collection
                      when '5'
                        render 'product-card-5', product: product, section: section, index: forloop.index, section_index: section.index, animated: animated, animation_effect: animation_effect, context: collection
                    endcase
                  %}
                </div>
              {%- endfor -%}
            </div>
            {% if paginate.pages > 1 %}
              <div class="m-collection--pagination m:text-center{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
                {%- if section.settings.paginate_type == 'paginate' -%}
                  {%- render 'pagination', paginate: paginate, anchor: '' -%}
                {%- else -%}
                  <button class="m-button m-button--primary m-spinner-button" data-load-more>
                    <span>
                      {%- render 'new-locale', key: 'collections.paginate.load_more' -%}
                    </span>
                    <span class="m-spinner-icon">
                      <svg
                        class="animate-spin m-svg-icon--medium"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                      >
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                      </svg>
                    </span>
                  </button>
                {%- endif -%}
              </div>
            {% endif %}
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
  {% if section.settings.show_sorting %}
    {%- render 'sort-by-mobile', results: collection -%}
  {% endif %}
</section>
<script>
  window.addEventListener('load', () => {
    if (typeof Collection !== 'undefined') {
      MinimogTheme.Collection = new Collection();
      MinimogTheme.Collection.init();
    }
    
    function initLoadMoreFilters() {
      document.querySelectorAll('.m-filter--widget-content').forEach(function(content) {
        if (content.querySelector('.m-filter--load-more-btn')) return;
        
        var list = content.querySelector('.m-facets');
        if (!list) return;
        var items = list.querySelectorAll('.m-facet--item');
        if (items.length > 5) {
          list.classList.add('has-load-more');
          var loadMoreBtn = document.createElement('button');
          loadMoreBtn.className = 'm-filter--load-more-btn';
          loadMoreBtn.textContent = 'Load more';
          loadMoreBtn.type = 'button';
          loadMoreBtn.addEventListener('click', function() {
            if (list.classList.contains('expanded')) {
              list.classList.remove('expanded');
              loadMoreBtn.textContent = 'Load more';
            } else {
              list.classList.add('expanded');
              loadMoreBtn.textContent = 'Show less';
            }
          });
          content.appendChild(loadMoreBtn);
        }
      });
    }
    
    initLoadMoreFilters();
    
    // Support dynamic updates (AJAX filters)
    var collectionGrid = document.getElementById('CollectionProductGrid');
    if (collectionGrid) {
      var observer = new MutationObserver(function() {
        initLoadMoreFilters();
      });
      observer.observe(collectionGrid, { childList: true, subtree: true });
    }
  });
  
  if (Shopify.designMode) {
    document.addEventListener('shopify:section:load', function (event) {
      MinimogTheme.Collection.init();
    });
  }
</script>
{% schema %}
{
  "name": "Product listing",
  "settings": [
    {
      "type": "paragraph",
      "content": "[Watch tutorial](https://foxecom.link/zHcHV5) or [read How-to](https://foxecom.link/CDVgnM)"
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default"
        },
        {
          "value": "container-full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Use container box"
