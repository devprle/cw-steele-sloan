{%- style -%}
  #{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.bg_image != blank %}
      background-image: url({{ section.settings.bg_image | image_url }});
      background-position: center center;
      background-repeat: no-repeat;
      background-size: cover;
    {% endif %}
    overflow: hidden;
    position: relative;
  }

  .floating-img-1-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: {{ section.settings.floating_image_1_size }}px;
    height: auto;
    object-fit: contain;
    z-index: 1;
    pointer-events: none;
  }

  .floating-img-2-{{ section.id }} {
    position: absolute;
    bottom: 0;
    right: 0;
    width: {{ section.settings.floating_image_2_size }}px;
    height: auto;
    object-fit: contain;
    z-index: 1;
    pointer-events: none;
  }

  #{{ section.id }} .page-width {
    max-width: {{ section.settings.page_width }}px;
    padding: 0 60px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  .features-heading-{{ section.id }} {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_desktop }}px;
    margin-bottom: 79px;
    
    margin-left: auto;
    margin-right: auto;
    font-family: var(--font-stack-body);
    font-weight: 200;
    line-height: 100%;
    letter-spacing: 0;
    text-align: center;
  }

  .features-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 40px;
  }

  .feature-item-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
        justify-content: space-between;
  }

  .feature-icon-{{ section.id }} {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    border-radius: 50%;
    border: 1px solid {{ section.settings.icon_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    padding: 15px;
  }

  .feature-icon-{{ section.id }} svg,
  .feature-icon-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    color: {{ section.settings.icon_color }};
  }

  .feature-title-{{ section.id }} {
    color: {{ section.settings.heading_color }};
    max-width: 160px;
    font-size: 16px;
    font-weight: 200;
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .feature-text-{{ section.id }} {
    color: {{ section.settings.text_color }};
    font-size: 12px;
    line-height: 1.5;
    margin: 0;
    font-weight: 200;
    max-width: 200px;
  }

  @media screen and (max-width: 1024px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.tablet_padding_top }}px;
      padding-bottom: {{ section.settings.tablet_padding_bottom }}px;
    }
    .features-grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 20px;
    }
    #{{ section.id }} .page-width {
      padding: 0 15px;
    }
  }

  @media screen and (max-width: 767px) {
    .floating-img-1-{{ section.id }} {
      width: {{ section.settings.floating_image_1_size | divided_by: 1.5 }}px;
    }
    .floating-img-2-{{ section.id }} {
      width: {{ section.settings.floating_image_2_size | divided_by: 1.5 }}px;
    }

    #{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      {% if section.settings.mobile_bg_image != blank %}
        background-image: url({{ section.settings.mobile_bg_image | image_url }});
      {% endif %}
    }

    .features-heading-{{ section.id }} {
      font-size: {{ section.settings.heading_size_mobile }}px;
      margin-bottom: 42px;
    }

    .features-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: 40px 20px;
    }

    .feature-icon-{{ section.id }} {
      width: {{ section.settings.icon_size | minus: 15 }}px;
      height: {{ section.settings.icon_size | minus: 15 }}px;
      margin-bottom: 20px;
      padding: 12px;
    }

    .feature-title-{{ section.id }} {
      font-size: 16px;
    }

    .feature-text-{{ section.id }} {
      font-size: 11px;
    }
  }
{%- endstyle -%}

<section id="{{ section.id }}" class="custom-features-section {{ section.settings.custom_class }}">
  {% if section.settings.floating_image_1 != blank %}
    <img src="{{ section.settings.floating_image_1 | image_url }}" width="auto" height="auto" class="floating-img-1-{{ section.id }}" alt="" loading="lazy">
  {% endif %}
  {% if section.settings.floating_image_2 != blank %}
    <img src="{{ section.settings.floating_image_2 | image_url }}" width="auto" height="auto" class="floating-img-2-{{ section.id }}" alt="" loading="lazy">
  {% endif %}

  <div class="page-width">
    {% if section.settings.title != blank %}
      <h2 class="features-heading-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    {% endif %}

    <div class="features-grid-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="feature-item-{{ section.id }}" {{ block.shopify_attributes }}>
          <div class="feature-icon-{{ section.id }}">
            {% if block.settings.icon_svg != blank %}
              {{ block.settings.icon_svg }}
            {% elsif block.settings.icon_image != blank %}
              {{ block.settings.icon_image | image_url: width: 100 | image_tag: loading: 'lazy' }}
            {% else %}
              <!-- Default Placeholder SVG -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            {% endif %}
          </div>

          {% if block.settings.title != blank %}
            <h3 class="feature-title-{{ section.id }}">{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="feature-text-{{ section.id }}">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Features Grid",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Jewelry that fits your life,\nnot the other way around."
    },
    {
      "type": "header",
      "content": "Typography & Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading & Title color",
      "default": "#1e2a40"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Icon circle border color",
      "default": "#d9b375"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "SVG Icon color",
      "default": "#d9b375"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size (Desktop)",
      "default": 42
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading size (Mobile)",
      "default": 28
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Icon circle size",
      "default": 90
    },
    {
      "type": "header",
      "content": "Floating Background Images"
    },
    {
      "type": "image_picker",
      "id": "floating_image_1",
      "label": "Top Left Image"
    },
    {
      "type": "range",
      "id": "floating_image_1_size",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Top Left Image Size",
      "default": 150
    },
    {
      "type": "image_picker",
      "id": "floating_image_2",
      "label": "Bottom Right Image"
    },
    {
      "type": "range",
      "id": "floating_image_2_size",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Bottom Right Image Size",
      "default": 150
    },
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "number",
      "id": "page_width",
      "label": "Page Width",
      "info": "Add PX number",
      "default": 1200
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Desktop background image",
      "info": "Tip: Use this to add the floating jewelry assets as a background."
    },
    {
      "type": "image_picker",
      "id": "mobile_bg_image",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "Desktop section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Tablet section padding"
    },
    {
      "type": "range",
      "id": "tablet_padding_top",
      "min": 50,
      "max": 150,
      "step": 1,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "tablet_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile section padding"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom padding",
      "default": 50
    },
    {
      "type": "header",
      "content": "Custom attributes"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom classes"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG",
          "info": "Paste SVG code here. It will automatically inherit the 'SVG Icon color' setting."
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image",
          "info": "Used if SVG is blank."
        },
        {
          "type": "richtext",
          "id": "title",
          "label": "Title",
          "default": "<h3>Feature Title</h3>"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Add a short description about this feature to inform your customers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Features Grid",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "<h3>Sensitive-skin friendly focus</h3>",
            "text": "stainless steel is a go-to for a great look at a great price point."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "<h3>Giftable by default</h3>",
            "text": "pieces people stop you to ask about."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "<h3>Customer-first service</h3>",
            "text": "honesty, respect, and support you can reach."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "<h3>Trend-forward, not try-hard</h3>",
            "text": "styles that keep you looking current and polished."
          }
        }
      ]
    }
  ]
}
{% endschema %}
