{%- style -%}
  #{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.bg_image != blank %}
      background-image: url({{ section.settings.bg_image | image_url }});
      background-position: center center;
      background-repeat: no-repeat;
      background-size: cover;
    {% endif %}
    overflow: hidden;
  }

  #{{ section.id }} .page-width {
    max-width: {{ section.settings.page_width }}px;
    padding: 0 60px;
    margin: 0 auto;
    width: 100%;
  }

  #{{ section.id }} .m-product-option--swatch .m-product-option--node__label {
    margin: 0 10px 0 0;
    width: 16px;
    height: 16px;
  }

  #{{ section.id }} .swiper-button:after {
    display: none;
  }

  #{{ section.id }} .swiper-button {
    padding: 12px;
    width: 40px;
    height: 40px;
  }

  .tabbed-collection-heading-{{ section.id }} {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: 71px;
    color: #0A2540;
    font-family: var(--font-stack-body);
    font-weight: 200;
    font-size: 42px;
    line-height: 100%;
    letter-spacing: 0;
  }

  .tabs-content-{{ section.id }}.top-slider {
    text-align: center;
    margin-bottom: 60px;
    overflow: visible;
    padding-bottom: 10px;
  }

  .tabs-preview-{{ section.id }} {
    position: relative;
    max-height: 182px;
    overflow: hidden;
    transition: max-height 0.6s ease;
  }

  .tabs-nav-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 22px;
    width: 100%;
    margin: 0 auto;
  }

  .tab-btn-{{ section.id }} {
    flex: 0 0 auto;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: none;
    background: #e5e7eb;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    opacity: 0.6;
    transition: opacity 0.3s ease, transform 0.3s ease;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  }

  .tabs-fade-{{ section.id }} {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 55%;
    background: linear-gradient(to bottom, rgba(242, 242, 242, 0) 0%, {{ section.settings.background_color | default: '#f2f2f2' }} 90%);
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .view-all-teams-{{ section.id }} {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border: 1px solid #c8c8c8;
    height: 50px;
    padding: 14px 34px;
    font-family: var(--font-stack-body);
    font-weight: 200;
    font-size: 14px;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    color: #0A2540;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .view-all-teams-{{ section.id }}:hover {
    box-shadow: unset;
  }

  .tabs-preview-{{ section.id }}.is-expanded {
    max-height: 4000px;
  }

  .tabs-preview-{{ section.id }}.is-expanded .tabs-fade-{{ section.id }},
  .tabs-preview-{{ section.id }}.is-expanded .view-all-teams-{{ section.id }} {
    opacity: 0;
    pointer-events: none;
  }

  .tab-btn-{{ section.id }}.active,
  .tab-btn-{{ section.id }}:hover {
    opacity: 1;
  }

  /* Inset shadow instead of border so the active ring doesn't shrink the content area */
  .tab-btn-{{ section.id }}.active::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 5px #0A2540;
    pointer-events: none;
  }

  .tab-img-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tab-overlay-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    transition: background 0.3s ease;
  }

  .tab-btn-{{ section.id }}:hover .tab-overlay-{{ section.id }} {
    background: rgba(0,0,0,0.25);
  }

  .tab-text-{{ section.id }} {
    color: #ffffff;
    font-size: 11px;
    font-weight: 500;
    text-align: center;
    line-height: 1.2;
    text-shadow: 0px 1px 4px rgba(0,0,0,0.7);
    word-break: break-word;
  }

  .tab-pane-{{ section.id }} {
    display: none;
  }

  .tab-pane-{{ section.id }}.active {
    display: block;
    animation: fadeInTab 0.5s ease forwards;
  }

  @keyframes fadeInTab {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .swiper-container-{{ section.id }} {
    width: 100%;
    padding-bottom: 0px;
    position: relative;
    overflow: visible;
  }

  .swiper-container-{{ section.id }} .swiper-slide {
    height: auto;
  }

  .swiper-container-{{ section.id }} .m-product-card__info {
    margin: 0;
  }

  .swiper-container-{{ section.id }} .m-product-card {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .swiper-container-{{ section.id }} .m-product-card__content {
    position: relative;
    background: #fff;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .swiper-button-next-{{ section.id }},
  .swiper-button-prev-{{ section.id }} {
    color: #ffffff;
    background: #0A2540;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    box-shadow: 0 4px 14px rgba(10,37,64,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 40%;
    z-index: 10;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .swiper-button-next-{{ section.id }}:hover,
  .swiper-button-prev-{{ section.id }}:hover {
    transform: scale(1.06);
    box-shadow: 0 6px 18px rgba(10,37,64,0.45);
  }

  .swiper-button-next-{{ section.id }} svg,
  .swiper-button-prev-{{ section.id }} svg {
    width: 10px;
    height: 18px;
  }

  .swiper-button-next-{{ section.id }} svg path,
  .swiper-button-prev-{{ section.id }} svg path {
    stroke: #ffffff;
    stroke-width: 1.5;
  }

  .swiper-button-prev-{{ section.id }} {
    left: -10px;
  }

  .swiper-button-next-{{ section.id }} {
    right: -10px;
  }

  .swiper-button-next-{{ section.id }}::after,
  .swiper-button-prev-{{ section.id }}::after {
    font-size: 16px;
    font-weight: bold;
  }

  .swiper-pagination-{{ section.id }} {
    text-align: center;
    position: absolute;
    bottom: 0;
    width: 100%;
    display: none;
  }

  .swiper-pagination-{{ section.id }} .swiper-pagination-bullet {
    background: #ccc;
    opacity: 1;
    margin: 0 4px;
  }

  .swiper-pagination-{{ section.id }} .swiper-pagination-bullet-active {
    background: #0A2540;
  }

  #{{ section.id }} a.m-product-card__name {
    font-family: var(--font-stack-body);
    font-weight: 200;
    font-size: 16px;
    line-height: 130%;
    letter-spacing: 0;
    color: #0A2540;
  }

  #{{ section.id }} button.m-add-to-cart.m-spinner-button,
  #{{ section.id }} button.m-product-form.m-product-quickview-button.m-spinner-button.m-button.m-button--secondary {
    border: 1px solid #0A2540;
    border-radius: 0px;
    font-family: var(--font-stack-body);
    font-weight: 300;
    font-size: 14px;
    color: #0A2540;
    line-height: 100%;
    letter-spacing: 5%;
    text-align: center;
    text-transform: uppercase;
    padding: 16px 12px;
    margin: 15px 0 0;
  }

  #{{ section.id }} span.m-price-item.m-price-item--regular {
    font-family: var(--font-stack-body);
    font-weight: 600;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0;
    color: #0A2540;
  }

  .product-review {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 10px;
  }

  .product-review span {
    font-family: Inter;
    font-weight: 300;
    font-size: 10px;
    line-height: 100%;
    letter-spacing: 0%;
    color: #0A2540;
  }

  #{{ section.id }} button.m-add-to-cart.m-spinner-button,
  #{{ section.id }} button.m-product-form.m-product-quickview-button.m-spinner-button.m-button.m-button--secondary {
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  #{{ section.id }} button.m-add-to-cart.m-spinner-button:hover,
  #{{ section.id }} button.m-product-form.m-product-quickview-button.m-spinner-button.m-button.m-button--secondary:hover {
    box-shadow: unset;
    background: #0A2540;
    color: #ffffff;
  }

  #{{ section.id }} .m-product-option--node__label {
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #{{ section.id }} .m-product-option--node__label:hover {
    transform: scale(1.15);
    box-shadow: 0 0 0 1px #ffffff, 0 0 0 2px #0A2540;
  }

  #{{ section.id }} .m-product-option--dropdown-select {
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  #{{ section.id }} .m-product-option--dropdown-select:hover {
    border-color: #0A2540;
  }

  #{{ section.id }} .m-product-card--style-4 .m-product-card__content .m-product-card__action-wrapper {
    margin: 0;
  }

  #{{ section.id }} .custom-product-badge {
    border-radius: 0;
    padding: 6px 16px 7px 15px;
    font-family: 'Inter', var(--font-stack-body);
    font-weight: 300;
    font-size: 10px;
    letter-spacing: 0;
    text-transform: none;
  }

  #{{ section.id }} .custom-product-badge--best,
  #{{ section.id }} .custom-product-badge--new {
    background: #ffffff;
    color: #0A2540;
  }

  #{{ section.id }} .m-product-option--swatch .m-product-option--node__label {
    border-radius: 50%;
  }

  @media screen and (max-width: 1024px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.tablet_padding_top }}px;
      padding-bottom: {{ section.settings.tablet_padding_bottom }}px;
    }

    .swiper-container-{{ section.id }} .m-product-card__content {
      padding: 24px 14px;
    }

    #{{ section.id }} .page-width {
      padding: 0 15px;
    }

    #{{ section.id }} .swiper-button-next-{{ section.id }},
    #{{ section.id }} .swiper-button-prev-{{ section.id }} {
      display: none !important;
    }
  }

  /* Prominent filled CTA under the grid (client asked for a more visible button) */
  #{{ section.id }} a.show-view-all.m-button.m-button--secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 320px;
    height: 58px;
    padding: 0 40px;
    border: 1px solid #0A2540;
    border-radius: 0;
    background: #0A2540;
    font-family: var(--font-stack-body);
    font-weight: 400;
    font-size: 15px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(10, 37, 64, 0.18);
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  #{{ section.id }} a.show-view-all.m-button.m-button--secondary:hover {
    background: #D4AF77;
    border-color: #D4AF77;
    color: #0A2540;
    box-shadow: 0 8px 22px rgba(212, 175, 119, 0.35);
    transform: translateY(-1px);
  }

  #{{ section.id }} .show-view-all-arrow {
    display: block;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  #{{ section.id }} a.show-view-all:hover .show-view-all-arrow {
    transform: translateX(4px);
  }

  .show-view-all-mobile-label-{{ section.id }} {
    display: none;
  }

  @media screen and (max-width: 767px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      {% if section.settings.mobile_bg_image != blank %}
        background-image: url({{ section.settings.mobile_bg_image | image_url }});
      {% endif %}
    }

    .tabs-content-{{ section.id }}.top-slider {
      margin-bottom: 32px;
    }

    #{{ section.id }} a.m-product-card__name {
      font-weight: 300;
      font-size: 11px;
    }

    #{{ section.id }} button.m-add-to-cart.m-spinner-button,
    #{{ section.id }} button.m-product-form.m-product-quickview-button.m-spinner-button.m-button.m-button--secondary {
      display: none;
    }

    #{{ section.id }} a.show-view-all.m-button.m-button--secondary {
      width: 100%;
      min-width: 0;
      height: 52px;
      padding: 0 10px;
      font-size: 14px;
      line-height: normal;
      font-family: 'Inter';
    }

    #{{ section.id }} .show-view-all-arrow {
      transform: rotate(90deg);
    }

    #{{ section.id }} a.show-view-all:hover .show-view-all-arrow {
      transform: rotate(90deg) translateX(3px);
    }

    .show-view-all-desktop-label-{{ section.id }} {
      display: none;
    }

    .show-view-all-mobile-label-{{ section.id }} {
      display: inline;
    }

    #{{ section.id }} .swiper-slide.mobile-extra-{{ section.id }} {
      display: none !important;
    }

    #{{ section.id }} .swiper-slide.mobile-extra-{{ section.id }}.is-revealed {
      display: block !important;
    }

    .swiper-container-{{ section.id }} .m-product-card__content {
      background: transparent;
      padding: 13px 0 0;
    }

    .tabbed-collection-heading-{{ section.id }} {
      text-align: {{ section.settings.header_alignment }};
      margin-bottom: 40px;
      color: #0A2540;
      font-weight: 200;
      font-size: 28px;
      line-height: 100%;
      letter-spacing: 0;
      text-align: center;
      padding: 0 10px;
    }

    .tab-text-{{ section.id }} {
      font-size: 13px;
    }

    .tabs-preview-{{ section.id }} {
      max-height: 154px;
    }

    .tabs-nav-{{ section.id }} {
      gap: 8px;
      padding: 0;
    }

    .tab-btn-{{ section.id }} {
      width: 73px;
      height: 73px;
      box-sizing: border-box;
    }

    .view-all-teams-{{ section.id }} {
      height: 38px;
      padding: 10px 34px;
    }

    .swiper-container-{{ section.id }} > .swiper-wrapper {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: {{ section.settings.item_gap_mobile }}px !important;
      transform: none !important;
    }

    .swiper-container-{{ section.id }} > .swiper-wrapper > .swiper-slide {
      width: 100% !important;
      height: auto !important;
      flex-shrink: initial !important;
    }

    .swiper-container-{{ section.id }} .m-product-card__media {
      overflow: hidden;
    }
  }
{%- endstyle -%}

{% liquid
  assign image_ratio = section.settings.pcard_image_ratio
  assign show_vendor = section.settings.show_vendor
  assign hide_title = section.settings.hide_title
%}

<section id="{{ section.id }}" class="custom-tabbed-collection-section {{ section.settings.custom_class }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="tabbed-collection-heading-{{ section.id }} {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 1 %}
      <div class="tabs-content-{{ section.id }} top-slider">
        <div class="tabs-preview-{{ section.id }}">
          <div class="tabs-nav-{{ section.id }}">
            {% for block in section.blocks %}
              {% assign col = collections[block.settings.collection] %}
              {% assign title = block.settings.tab_title | default: col.title | default: 'Collection' %}
              {% assign img = block.settings.tab_image | default: col.image | default: col.products.first.featured_image %}

              <button
                class="tab-btn-{{ section.id }} {% if forloop.first %}active{% endif %}"
                data-target="tab-pane-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
              >
                {% assign tab_img_class = 'tab-img-' | append: section.id %}
                {% if img != blank %}
                  {{ img | image_url: width: 200 | image_tag: class: tab_img_class, loading: 'lazy' }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: tab_img_class }}
                {% endif %}

                <div class="tab-overlay-{{ section.id }}">
                  <span class="tab-text-{{ section.id }}">{{ title }}</span>
                </div>
              </button>
            {% endfor %}
          </div>

          {% if section.settings.show_view_all_teams %}
            <div class="tabs-fade-{{ section.id }}"></div>
            <button
              type="button"
              class="view-all-teams-{{ section.id }} js-expand-tabs-{{ section.id }}"
            >
              {{ section.settings.view_all_teams_text | default: 'View more' }}
            </button>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="tabs-content-{{ section.id }}">
      {% for block in section.blocks %}
        {% assign col = collections[block.settings.collection] %}

        <div
          class="tab-pane-{{ section.id }} {% if forloop.first or section.blocks.size == 1 %}active{% endif %}"
          id="tab-pane-{{ section.id }}-{{ forloop.index }}"
        >
          <div class="swiper swiper-container-{{ section.id }}">
            <div class="swiper-wrapper">
              {% if col != blank and col.products.size > 0 %}
                {% for product in col.products limit: section.settings.product_to_show %}
                  <div class="swiper-slide{% if forloop.index > 4 %} mobile-extra-{{ section.id }}{% endif %}">
                    {% render 'custom-product-card',
                      product: product,
                      image_ratio: image_ratio,
                      show_vendor: show_vendor,
                      hide_title: hide_title,
                      show_cart_button: section.settings.show_cart_button,
                      show_variant_options: true
                    %}
                  </div>
                {% endfor %}
              {% else %}
                {% for i in (1..section.settings.product_to_show) %}
                  <div class="swiper-slide">
                    <div class="m-product-card m-product-card--placeholder">
                      <div class="m-product-card__media" style="--aspect-ratio: 1/1;">
                        {% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}
                        {{
                          'product-'
                          | append: current
                          | placeholder_svg_tag: 'm-placeholder-svg m:object-cover m:w-full m:h-full'
                        }}
                      </div>

                      <div class="m-product-card__content m:text-center m:mt-4">
                        <div class="m-product-card__name">Example Product</div>
                        <div class="m-product-card__price">$19.99</div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>

            <div class="swiper-pagination swiper-pagination-{{ section.id }}"></div>

            <div class="swiper-button swiper-button-prev swiper-button-prev-{{ section.id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="7" height="13" viewBox="0 0 7 13" fill="none">
                <path d="M6.5 0.5L0.5 6.5L6.5 12.5" stroke="#0A2540" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <div class="swiper-button swiper-button-next swiper-button-next-{{ section.id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="7" height="13" viewBox="0 0 7 13" fill="none">
                <path d="M0.5 12.5L6.5 6.5L0.499999 0.5" stroke="#0A2540" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>

          {% if section.settings.show_view_all and col != blank %}
            <div style="text-align: center; margin-top: 30px;">
              <a
                href="{{ col.url }}"
                class="show-view-all show-view-all-{{ section.id }} m-button m-button--secondary"
              >
                <span class="show-view-all-desktop-label-{{ section.id }}">View All Products</span>
                <span class="show-view-all-mobile-label-{{ section.id }}">Load More Products</span>
                <svg class="show-view-all-arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <path d="M3 9h12M10 4l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('{{ section.id }}');
    if (!section) return;

    const swipers = [];
    const swiperContainers = section.querySelectorAll('.swiper-container-{{ section.id }}');
    const desktopMql = window.matchMedia('(min-width: 768px)');

    function syncSwiper(container) {
      if (desktopMql.matches) {
        if (!container.swiperInstance) {
          const swiper = new Swiper(container, {
            slidesPerView: 3,
            spaceBetween: {{ section.settings.item_gap }},
            loop: true,
            observer: true,
            observeParents: true,
            pagination: {
              el: container.querySelector('.swiper-pagination-{{ section.id }}'),
              clickable: true,
            },
            navigation: {
              nextEl: container.querySelector('.swiper-button-next-{{ section.id }}'),
              prevEl: container.querySelector('.swiper-button-prev-{{ section.id }}'),
            },
            breakpoints: {
              1024: {
                slidesPerView: {{ section.settings.items_per_row }},
                spaceBetween: {{ section.settings.item_gap }},
              }
            }
          });

          container.swiperInstance = swiper;
          swipers.push(swiper);
        }
      } else if (container.swiperInstance) {
        const index = swipers.indexOf(container.swiperInstance);
        if (index > -1) swipers.splice(index, 1);
        container.swiperInstance.destroy(true, true);
        container.swiperInstance = null;
      }
    }

    swiperContainers.forEach(syncSwiper);

    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        swiperContainers.forEach(syncSwiper);
      }, 200);
    });

    const tabs = section.querySelectorAll('.tab-btn-{{ section.id }}');
    const panes = section.querySelectorAll('.tab-pane-{{ section.id }}');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        panes.forEach(p => p.classList.remove('active'));

        tab.classList.add('active');

        const targetId = tab.getAttribute('data-target');
        const targetPane = section.querySelector('#' + targetId);

        if (targetPane) {
          targetPane.classList.add('active');

          const swiperContainer = targetPane.querySelector('.swiper-container-{{ section.id }}');

          if (swiperContainer && swiperContainer.swiper) {
            setTimeout(() => {
              swiperContainer.swiper.update();
            }, 50);
          }
        }
      });
    });

    const expandBtn = section.querySelector('.js-expand-tabs-{{ section.id }}');
    if (expandBtn) {
      expandBtn.addEventListener('click', () => {
        const preview = expandBtn.closest('.tabs-preview-{{ section.id }}');
        if (preview) preview.classList.add('is-expanded');
      });
    }

    const mobileMql = window.matchMedia('(max-width: 767px)');
    const viewAllLinks = section.querySelectorAll('.show-view-all-{{ section.id }}');

    viewAllLinks.forEach(link => {
      link.addEventListener('click', function (event) {
        if (!mobileMql.matches) return;

        const pane = link.closest('.tab-pane-{{ section.id }}');
        if (!pane) return;

        const hiddenExtras = pane.querySelectorAll('.mobile-extra-{{ section.id }}:not(.is-revealed)');
        if (hiddenExtras.length > 0) {
          event.preventDefault();
          hiddenExtras.forEach(el => el.classList.add('is-revealed'));
        }
      });
    });
  });
</script>

